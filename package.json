{
  "name": "lzma-web",
  "description": "A JavaScript implementation of the Lempel-Ziv-Markov (LZMA) chain compression algorithm",
  "version": "4.0.0",
  "homepage": "https://github.com/biw/lzma-web",
  "repository": {
    "type": "git",
    "url": "git://github.com/biw/lzma-web.git"
  },
  "bugs": {
    "url": "https://github.com/biw/lzma-web/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "sync": [
        "dist/sync.d.ts"
      ],
      "worker": [
        "dist/worker-api.d.ts"
      ],
      "compress": [
        "dist/compress.d.ts"
      ],
      "decompress": [
        "dist/decompress.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js",
      "require": "./dist/sync.cjs"
    },
    "./worker": {
      "types": "./dist/worker-api.d.ts",
      "import": "./dist/worker-api.js",
      "require": "./dist/worker-api.cjs"
    },
    "./compress": {
      "types": "./dist/compress.d.ts",
      "import": "./dist/compress.js",
      "require": "./dist/compress.cjs"
    },
    "./decompress": {
      "types": "./dist/decompress.d.ts",
      "import": "./dist/decompress.js",
      "require": "./dist/decompress.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@napi-rs/lzma": "^1.4.5",
    "@sarakusha/lzma": "^2.3.4",
    "@types/node": "26.4.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.11",
    "lzma": "^2.3.2",
    "lzma-native": "^8.0.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.57.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "generate": "node scripts/generate-modules.js",
    "prebuild": "node scripts/generate-modules.js",
    "build": "tsup && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:electron": "pnpm generate && pnpm build && node scripts/test-electron-packaged.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:perf": "node scripts/track-perf.js",
    "test:bench": "vitest bench",
    "test:compare": "vitest bench tests/comparison.bench.ts",
    "pretest:browser": "pnpm build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:coverage": "pnpm build && vitest run --config vitest.browser.config.ts --coverage",
    "test:package": "pnpm build && node scripts/test-package-consumer.mjs",
    "test:all": "pnpm test && pnpm test:package && pnpm test:browser",
    "test:release": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test:coverage && pnpm test:package && pnpm test:browser:coverage && pnpm test:electron",
    "lint": "oxlint src",
    "format": "oxfmt --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "oxfmt --check 'src/**/*.ts' 'tests/**/*.ts'",
    "type-check": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "license": "MIT",
  "keywords": [
    "lzma",
    "compression",
    "decompression"
  ],
  "packageManager": "pnpm@11.18.0"
}
